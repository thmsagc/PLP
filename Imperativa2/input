// ============================================================================
// CASO 1: Carregamento do .env + variavel declarada + tipos + escopo com with
// (ATIVO)
// ============================================================================
loadenv ".env",
env tentativas : int = 5;
write($APP_NAME);
write($HOST);
write($PORTA);
write($DEBUG);
(with PORTA = 9090 do write($PORTA));
write($PORTA);
write($tentativas)

