options {
  JAVA_UNICODE_ESCAPE = true;
  STATIC = false;
  DEBUG_PARSER = false;
}

PARSER_BEGIN(DotenvParser)

package li2.plp.imperative2.dotenv.parser;

import li2.plp.expressions2.expression.Id;
import li2.plp.imperative2.dotenv.model.*;
import java.io.*;

public class DotenvParser {

    public static ArquivoDotenv parse(File arquivo) throws ParseException, IOException {
        FileInputStream fis = new FileInputStream(arquivo);
        try {
            DotenvParser parser = new DotenvParser(fis);
            return parser.PArquivoDotenv();
        } finally {
            fis.close();
        }
    }

    public static void main(String[] args) {
        DotenvParser parser;
        if (args.length == 0) {
            System.out.println("DotenvParser: Lendo da entrada padrao . . .");
            parser = new DotenvParser(System.in);
        } else {
            System.out.println("DotenvParser: Lendo do arquivo " + args[0] + " . . .");
            try {
                parser = new DotenvParser(new FileInputStream(args[0]));
            } catch (FileNotFoundException e) {
                System.err.println("Arquivo " + args[0] + " nao encontrado.");
                return;
            }
        }

        try {
            ArquivoDotenv arquivo = parser.PArquivoDotenv();
            System.out.println("Dotenv processado com sucesso:");
            for (EntradaDotenv entrada : arquivo.getEntradasComoLista()) {
                System.out.println("  " + entrada.getId() + " = " + entrada.getValorTexto() + 
                    " (aspado=" + (entrada.temValor() && entrada.getValor().isAspado()) + ")");
            }
        } catch (ParseException e) {
            System.err.println("Erro ao analisar arquivo .env: " + e.getMessage());
        }
    }
}

PARSER_END(DotenvParser)


<DEFAULT> SKIP :
{
  " "
| "\t"
| "\f"
| "\r"
| "\n"
| <"#" (~["\r","\n"])*>
}

<DEFAULT> TOKEN :
{
  < ASSIGN: "=" > : IN_VALUE
|
  < IDENTIFIER: <LETTER> (<LETTER>|<DIGIT>)* >
|
  < #LETTER:
      [
       "\u0041"-"\u005a",
       "\u005f",
       "\u0061"-"\u007a",
       "\u00c0"-"\u00d6",
       "\u00d8"-"\u00f6",
       "\u00f8"-"\u00ff",
       "\u0100"-"\u1fff",
       "\u3040"-"\u318f",
       "\u3300"-"\u337f",
       "\u3400"-"\u3d2d",
       "\u4e00"-"\u9fff",
       "\uf900"-"\ufaff"
      ]
  >
|
  < #DIGIT:
      [
       "\u0030"-"\u0039",
       "\u0660"-"\u0669",
       "\u06f0"-"\u06f9",
       "\u0966"-"\u096f",
       "\u09e6"-"\u09ef",
       "\u0a66"-"\u0aef",
       "\u0ae6"-"\u0aef",
       "\u0b66"-"\u0b6f",
       "\u0be7"-"\u0bef",
       "\u0c66"-"\u0c6f",
       "\u0ce6"-"\u0cef",
       "\u0d66"-"\u0d6f",
       "\u0e50"-"\u0e59",
       "\u0ed0"-"\u0ed9",
       "\u1040"-"\u1049"
      ]
  >
}

<IN_VALUE> SKIP :
{
  " "
| "\t"
| <("\r\n" | "\n" | "\r")> : DEFAULT
| <"#" (~["\r","\n"])* ("\r\n" | "\n" | "\r")?> : DEFAULT
}

<IN_VALUE> TOKEN :
{
  < VALOR_ASPADO:
      "\""
      (   (~["\"","\\","\n","\r"])
        | ("\\"
            ( ["n","t","b","r","f","\\","'","\"","$"]
            | ["0"-"7"] ( ["0"-"7"] )?
            | ["0"-"3"] ["0"-"7"] ["0"-"7"]
            )
          )
      )*
      "\""
    |
      "\'"
      (   (~["\'","\\","\n","\r"])
        | ("\\"
            ( ["n","t","b","r","f","\\","'","\"","$"]
            )
          )
      )*
      "\'"
  > : AFTER_VALUE
|
  < VALOR_SIMPLES: (~["\r", "\n", "\"", "\'", "#", " ", "\t"]) (~["\r", "\n", "#"])* > : AFTER_VALUE
}

<AFTER_VALUE> SKIP :
{
  " "
| "\t"
| <("\r\n" | "\n" | "\r")> : DEFAULT
| <"#" (~["\r","\n"])* ("\r\n" | "\n" | "\r")?> : DEFAULT
}


ArquivoDotenv PArquivoDotenv() :
{
    ListaEntradaDotenv lista = null;
}
{
    [ lista = PListaEntradaDotenv() ] <EOF>
    {
        return new ArquivoDotenv(lista);
    }
}

ListaEntradaDotenv PListaEntradaDotenv() :
{
    EntradaDotenv entrada;
    ListaEntradaDotenv lista = null;
}
{
    entrada = PEntradaDotenv()
    [
        LOOKAHEAD(PId())
        lista = PListaEntradaDotenv()
    ]
    {
        return new ListaEntradaDotenv(entrada, lista);
    }
}

EntradaDotenv PEntradaDotenv() :
{
    Id id;
    ValorDotenv valor = null;
}
{
    id = PId() <ASSIGN> [ valor = PValorDotenv() ]
    {
        return new EntradaDotenv(id, valor);
    }
}

ValorDotenv PValorDotenv() :
{
    ValorDotenv valor;
}
{
    (
        valor = PValorAspado()
      | valor = PValorSimples()
    )
    {
        return valor;
    }
}

ValorAspado PValorAspado() :
{
    Token token;
}
{
    token = <VALOR_ASPADO>
    {
        String raw = token.image;
        String unquoted = raw.substring(1, raw.length() - 1);
        boolean aspasSimples = raw.startsWith("'");
        return new ValorAspado(unquoted, aspasSimples);
    }
}

ValorSimples PValorSimples() :
{
    Token token;
}
{
    token = <VALOR_SIMPLES>
    {
        return new ValorSimples(token.image.trim());
    }
}

Id PId() :
{
    Token token;
}
{
    token = <IDENTIFIER>
    {
        return new Id(token.image);
    }
}
